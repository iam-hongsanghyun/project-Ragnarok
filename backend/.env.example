# Backend environment overrides. Copy to backend/.env and edit.
#
# backend/.env is loaded ONCE at process start (backend/env_file.py, called from
# backend/app/__init__.py and the MCP entrypoint) before any setting is read.
# A variable already set in the process environment wins over this file.
# Format: NAME=value per line; '#' comment lines and blank lines are ignored;
# values may be wrapped in single or double quotes; no interpolation.
#
# Launcher-only variables (read by the .command/.ps1 shell scripts, NOT by
# Python, so they must be exported in the shell, not set here):
#   RAGNAROK_PORT (serve), RAGNAROK_PLUGINS_ENV (run/serve).
# A test asserts that every variable the backend reads appears in this file.

# ── Session storage engine ──────────────────────────────────────────────────

# Working-model store backend. Default is "sqlite": one project.db per session
# (backend/data/session/<id>/project.db) — Ragnarok keeps zero scattered files,
# and any pre-flip JSON/Parquet session is migrated into its project.db on first
# read. Set to "legacy" to keep the old JSON + Parquet files (escape hatch).
# RAGNAROK_STORE=sqlite

# Root folder for Ragnarok's working data (sessions, runs, caches, plugins,
# secrets). Default: backend/data inside the checkout.
# RAGNAROK_DATA_DIR=/abs/path/to/data

# Edit journal (undo/revert): folder, max entries kept, max bytes of snapshots.
# RAGNAROK_JOURNAL_DIR=
# RAGNAROK_JOURNAL_MAX_ENTRIES=200
# RAGNAROK_JOURNAL_MAX_BYTES=1000000000

# Screening module: uploaded per-site / per-region series, kept per session
# under <data root>/screening_datasets/ (the older siting_datasets/ is migrated). Upload size cap (bytes), sites per dataset,
# sites per correlation / cluster / metrics request, points of a chart series,
# longest lag searched (hours), longest gap interpolated (steps).
# RAGNAROK_SITING_MAX_UPLOAD_BYTES=209715200
# RAGNAROK_SITING_MAX_SITES=400
# RAGNAROK_SITING_MAX_MATRIX_SITES=60
# RAGNAROK_SITING_MAX_STRUCTURE_SITES=400
# RAGNAROK_SITING_MAX_CHART_POINTS=500
# RAGNAROK_SITING_MAX_LAG_HOURS=336
# RAGNAROK_SITING_MAX_INTERP_STEPS=48

# ── Solve queue ─────────────────────────────────────────────────────────────

# Startup default for max concurrent solves (clamped to [1, CPU count]).
# RAGNAROK_QUEUE_CONCURRENCY=1

# ── Data importer API keys (server-side; NEVER commit real values) ──────────

# Any RAGNAROK_SECRET_<NAME> provides the importer secret <name> (lowercased)
# to every /api/import/run request — so users need no key in the browser. A
# key typed in Settings → API keys (BYOK) overrides the server's for that
# request only. Values live ONLY in backend/.env (gitignored).
# RAGNAROK_SECRET_EIA_KEY=
# RAGNAROK_SECRET_ENTSOE_KEY=

# ── Data importer subsystem (Data view) ─────────────────────────────────────

# Natural Earth country boundaries GeoJSON source (downloaded once, then cached
# under RAGNAROK_CACHE_DIR).
# RAGNAROK_BOUNDARIES_URL=https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_110m_admin_0_countries.geojson
# RAGNAROK_CACHE_DIR=

# OpenStreetMap Overpass endpoint. Defaults to the public main instance;
# override for self-hosted (Kumi Systems, etc.) deployments.
# RAGNAROK_OVERPASS_URL=https://overpass-api.de/api/interpreter

# WRI Global Power Plant Database CSV URL. Public.
# RAGNAROK_WRI_GPPD_URL=

# Importer caches and the provenance log (defaults sit under RAGNAROK_DATA_DIR).
# RAGNAROK_IMPORT_CACHE=
# RAGNAROK_WEATHER_CACHE=
# RAGNAROK_PROVENANCE_LOG=

# Self-hosted hourly demand database (D2): folder for the parquet slices, manifest and raw
# downloads written by `python -m backend.app.importers.demand_db.refresh` and read by the
# `demand_db` importer, /api/demand-db/* and the MCP tools. Default: <RAGNAROK_DATA_DIR>/demand_db.
# RAGNAROK_DEMAND_DB_DIR=

# ── P2X (power-to-X) ─────────────────────────────────────────────────────────
# Technology data file for the P2X chains (same schema as backend/app/p2x/technologies.json).
# Default: the bundled file (PyPSA/technology-data v0.15.0 + DEA renewable fuels, EUR2025).
# RAGNAROK_P2X_TECHNOLOGIES_FILE=
# Build plants (CCGT, OCGT, gas + H2 co-firing, BESS): technology data file with the same schema as
# backend/app/plants/technologies.json (value, unit, source, verified flag). Blank = the bundled file.
# RAGNAROK_PLANTS_TECHNOLOGIES_FILE=

# ── PyPSA-Earth integration ─────────────────────────────────────────────────

# A checked-out pypsa-earth workflow dir (must contain a Snakefile) and the
# conda env name that holds snakemake + the workflow's dependencies.
# RAGNAROK_PYPSA_EARTH_DIR=/abs/path/to/pypsa-earth
# RAGNAROK_PYPSA_EARTH_CONDA_ENV=pypsa-earth

# ── Plugins and tab modules ─────────────────────────────────────────────────

# Install dir for backend plugins, per-plugin uploaded-file scratch dir, and
# upload size guards in MB (0 disables a limit).
# RAGNAROK_BACKEND_PLUGINS_DIR=
# RAGNAROK_PLUGIN_FILES_DIR=
# RAGNAROK_MAX_PLUGIN_ZIP_MB=50
# RAGNAROK_MAX_PLUGIN_FILE_MB=200
# RAGNAROK_MAX_PLUGIN_UNZIPPED_MB=500
# External tab modules: install dir and zip / unzipped size guards (MB).
# RAGNAROK_TAB_MODULES_DIR=
# RAGNAROK_MAX_MODULE_ZIP_MB=50
# RAGNAROK_MAX_MODULE_UNZIPPED_MB=200

# ── Physical risk (CLIMADA worker) ──────────────────────────────────────────

# Persistence dir and executor size for physical-risk runs.
# RAGNAROK_PHYSICAL_RISK_DIR=
# RAGNAROK_PHYSICAL_RISK_WORKERS=2
# Worker selection: auto (use it when its env exists) | on | off; the conda
# prefix env holding it; wall-clock cap per run in seconds.
# RAGNAROK_CLIMADA_WORKER=auto
# RAGNAROK_CLIMADA_WORKER_ENV=
# RAGNAROK_CLIMADA_TIMEOUT=900
# Read by the worker subprocess (inherited): hazard catalog dir, DEM raster,
# exposure raster, EM-DAT calibration file.
# CLIMATERISK_HAZARD_DB=
# CLIMATERISK_DEM_PATH=
# CLIMATERISK_EXPOSURE_RASTER=
# CLIMATERISK_EMDAT_PATH=

# ── Server mode (serve the built project-Mjolnir client) ─────────────────────
# Where the client's production build lives. Default: ./build (this repo's
# `npm run build` output). The backend serves it at / so browsers on the LAN
# just open http://<this-host>:8000.
# RAGNAROK_FRONTEND_DIST=/abs/path/to/build

# ── MCP server (python -m backend.mcp) ──────────────────────────────────────

# Backend the MCP server talks to, the working-model session it edits, the
# per-call HTTP timeout (s), and the actor / conversation labels it stamps on
# journal entries.
# RAGNAROK_API_BASE=http://127.0.0.1:8000
# RAGNAROK_SESSION_ID=bifrost
# RAGNAROK_HTTP_TIMEOUT=120
# RAGNAROK_MCP_ACTOR=mcp
# RAGNAROK_MCP_CONVERSATION=
# Autonomy guard: auto | guided | manual.  Folder file-based tools read/write.
# RAGNAROK_MCP_AUTONOMY=guided
# RAGNAROK_MCP_FILE_DIR=.
# Transport: stdio | streamable-http, and the HTTP listener settings.
# RAGNAROK_MCP_TRANSPORT=stdio
# RAGNAROK_MCP_HOST=127.0.0.1
# RAGNAROK_MCP_PORT=8765
# RAGNAROK_MCP_PATH=/mcp
# RAGNAROK_MCP_ALLOWED_HOSTS=
# Start/stop the backend automatically when nothing answers at RAGNAROK_API_BASE.
# RAGNAROK_MCP_AUTOSTART=
# RAGNAROK_REPO_ROOT=
# RAGNAROK_CONNECTOR_DIR=
# RAGNAROK_AUTOSTART_TIMEOUT=300
